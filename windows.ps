param(
    [switch]$NoCache,
    [switch]$SkipMigrations,
    [switch]$SkipSeed
)

$scriptPath = Join-Path $PSScriptRoot 'windows.cmd'

if (-not (Test-Path $scriptPath)) {
    throw "windows.cmd was not found."
}

$arguments = @()

if ($NoCache) {
    $arguments += '--no-cache'
}

if ($SkipMigrations) {
    $arguments += '--skip-migrations'
}

if ($SkipSeed) {
    $arguments += '--skip-seed'
}

& $scriptPath @arguments

if ($LASTEXITCODE -ne 0) {
    throw "Deployment failed with exit code $LASTEXITCODE."
}
