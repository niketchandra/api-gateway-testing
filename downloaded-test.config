# Sample Configuration File
# This is a test configuration for API Gateway

[database]
host=localhost
port=3306
username=root
database=atglance

[redis]
host=localhost
port=6379
connection_timeout=30

[api]
rate_limit=100
timeout=60
max_retries=3

[logging]
level=debug
format=json
output=/var/log/api.log
