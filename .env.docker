# Shared environment values for docker-compose services

# App
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=http://localhost:8000
VERSION=0.1.2

# Database + cache for Laravel containers
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=atglance
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# MySQL container
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_DATABASE=atglance
MYSQL_ROOT_HOST=%

# phpMyAdmin container
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=
